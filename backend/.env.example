APP_ENV=development
DEBUG=true
# Default port is 5432. If you have a native PostgreSQL install already using 5432,
# set DATABASE_URL to port 5434 and add POSTGRES_PORT=5434 to the root .env
# (next to docker-compose.yml) so the container maps to 5434 instead.
DATABASE_URL=postgresql+asyncpg://example_user:example_password@localhost:5432/example_database
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
CORS_ORIGINS=http://localhost:3000

SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
