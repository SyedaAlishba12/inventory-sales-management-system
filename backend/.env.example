APP_ENV=development
DEBUG=true
# Default port is 5432. If you have a native PostgreSQL install already using 5432,
# set DATABASE_URL to port 5434 and add POSTGRES_PORT=5434 to the root .env
# (next to docker-compose.yml) so the container maps to 5434 instead.
DATABASE_URL=postgresql+asyncpg://example_user:example_password@localhost:5432/example_database
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
CORS_ORIGINS=http://localhost:3000

SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=15

# SMTP / Email Delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Admin Bootstrapping
# To bootstrap the first admin account, set these variables and run:
# python -m scripts.seed_admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=SuperSecretAdmin123!
ADMIN_SEED_NAME=System Admin
